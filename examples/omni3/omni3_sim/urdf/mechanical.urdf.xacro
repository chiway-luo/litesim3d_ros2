<?xml version="1.0"?>
<robot name="omni3" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="body"><color rgba="0.1 0.4 0.7 1"/></material>
  <material name="rubber"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="spoke"><color rgba="0.95 0.65 0.1 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_fixed" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>
  <link name="base_link">
    <visual><origin xyz="0 0 0.22"/><geometry><box size="0.38 0.38 0.16"/></geometry><material name="body"/></visual>
    <collision><origin xyz="0 0 0.22"/><geometry><box size="0.38 0.38 0.16"/></geometry></collision>
  </link>
  <xacro:macro name="wheel" params="joint x y angle radius:=0.1">
    <link name="${joint}_link">
      <!-- 外观用轮毂圆柱和色条；被动滚子的自由方向由运动学约束描述。 -->
      <visual><origin rpy="${-pi/2} 0 0"/><geometry><cylinder radius="${radius}" length="0.04"/></geometry><material name="rubber"/></visual>
      <visual><geometry><box size="0.15 0.045 0.015"/></geometry><material name="spoke"/></visual>
      <collision><origin rpy="${-pi/2} 0 0"/><geometry><cylinder radius="${radius}" length="0.04"/></geometry></collision>
    </link>
    <joint name="${joint}" type="continuous">
      <parent link="base_link"/><child link="${joint}_link"/>
      <origin xyz="${x} ${y} ${radius}" rpy="0 0 ${angle}"/>
      <axis xyz="0 1 0"/><limit effort="20" velocity="30"/>
    </joint>
  </xacro:macro>
  <xacro:wheel joint="wheel_0_joint" x="0.3" y="0" angle="1.570796326794897"/>
  <xacro:wheel joint="wheel_1_joint" x="-0.1499999999999999" y="0.2598076211353316" angle="3.665191429188092"/>
  <xacro:wheel joint="wheel_2_joint" x="-0.1500000000000001" y="-0.2598076211353315" angle="5.759586531581287"/>
</robot>
