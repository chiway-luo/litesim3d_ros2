<?xml version="1.0"?>
<!--
  四轮小车，单位：米、弧度、千克；坐标：x 前、y 左、z 上。
  车体 0.74 × 0.48 × 0.18 m；轮半径 0.12 m，轮宽 0.07 m；
  左右轮中心距 0.58 m，前后轮中心距 0.48 m。
  base_link/base_footprint 均在车体中心的地面投影，车体几何自身上移。
  后轮为左右两侧的独立驱动关节，前轮 mimic 同侧后轮。
  整体使用同侧等速的差速运动学，不模拟四个独立电机或轮胎滑移力。
  雷达与 IMU 在仿真 YAML 中启用，URDF 这里只声明安装位置和外观。
-->
<robot name="wheel_car_4w" version="1.0">
  <material name="body_blue"><color rgba="0.10 0.36 0.70 1"/></material>
  <material name="deck_light"><color rgba="0.80 0.85 0.90 1"/></material>
  <material name="rubber"><color rgba="0.06 0.07 0.08 1"/></material>
  <material name="hub"><color rgba="0.52 0.57 0.62 1"/></material>
  <material name="spoke"><color rgba="0.95 0.65 0.12 1"/></material>
  <material name="sensor_green"><color rgba="0.12 0.75 0.48 1"/></material>
  <material name="front_red"><color rgba="0.92 0.18 0.12 1"/></material>

  <!-- 无惯性的纯坐标 root，避免 KDL 对根 link 惯性的警告。 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.25"/>
      <mass value="12"/>
      <inertia ixx="0.2628" ixy="0" ixz="0" iyy="0.58" iyz="0" izz="0.778"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.74 0.48 0.18"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry><box size="0.74 0.48 0.18"/></geometry>
    </collision>
    <!-- 顶板和车头标记都是同一 link 的 visual，不额外增加碰撞体。 -->
    <visual>
      <origin xyz="0 0 0.345"/>
      <geometry><box size="0.70 0.44 0.01"/></geometry>
      <material name="deck_light"/>
    </visual>
    <visual>
      <origin xyz="0.375 0 0.25"/>
      <geometry><box size="0.01 0.30 0.07"/></geometry>
      <material name="front_red"/>
    </visual>
  </link>

  <!-- 所有轮关节轴为底盘 +y；圆柱本地 z 轴经 -π/2 绕 x 旋转后对齐 +y。
       碰撞圆柱必须居中、共轴。轮毂/色条只改变 visual，便于观察转动。 -->
  <link name="rear_left_wheel_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.003207" ixy="0" ixz="0" iyy="0.00576" iyz="0" izz="0.003207"/>
    </inertial>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.065" length="0.072"/></geometry>
      <material name="hub"/>
    </visual>
    <visual>
      <geometry><box size="0.18 0.074 0.018"/></geometry>
      <material name="spoke"/>
    </visual>
    <collision>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel_link"/>
    <origin xyz="-0.24 0.29 0.12"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" velocity="30"/>
  </joint>

  <link name="rear_right_wheel_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.003207" ixy="0" ixz="0" iyy="0.00576" iyz="0" izz="0.003207"/>
    </inertial>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.065" length="0.072"/></geometry>
      <material name="hub"/>
    </visual>
    <visual>
      <geometry><box size="0.18 0.074 0.018"/></geometry>
      <material name="spoke"/>
    </visual>
    <collision>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel_link"/>
    <origin xyz="-0.24 -0.29 0.12"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" velocity="30"/>
  </joint>

  <!-- 前轮直接挂在 base_link 上，不能作为后轮 link 的子节点。
       mimic 同步同侧转角/角速度，不建立第二套控制输入。 -->
  <link name="front_left_wheel_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.003207" ixy="0" ixz="0" iyy="0.00576" iyz="0" izz="0.003207"/>
    </inertial>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.065" length="0.072"/></geometry>
      <material name="hub"/>
    </visual>
    <visual>
      <geometry><box size="0.18 0.074 0.018"/></geometry>
      <material name="spoke"/>
    </visual>
    <collision>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel_link"/>
    <origin xyz="0.24 0.29 0.12"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" velocity="30"/>
    <mimic joint="rear_left_wheel_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="front_right_wheel_link">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.003207" ixy="0" ixz="0" iyy="0.00576" iyz="0" izz="0.003207"/>
    </inertial>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
      <material name="rubber"/>
    </visual>
    <visual>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.065" length="0.072"/></geometry>
      <material name="hub"/>
    </visual>
    <visual>
      <geometry><box size="0.18 0.074 0.018"/></geometry>
      <material name="spoke"/>
    </visual>
    <collision>
      <origin rpy="-1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.12" length="0.07"/></geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel_link"/>
    <origin xyz="0.24 -0.29 0.12"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" velocity="30"/>
    <mimic joint="rear_right_wheel_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="lidar_mount_link">
    <visual><geometry><cylinder radius="0.025" length="0.11"/></geometry><material name="hub"/></visual>
    <collision><geometry><cylinder radius="0.025" length="0.11"/></geometry></collision>
  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_mount_link"/>
    <origin xyz="0.12 0 0.405"/>
  </joint>
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="sensor_green"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount_link"/><child link="lidar_link"/>
    <!-- 最终雷达中心相对 base_link 为 [0.12, 0, 0.49] m。 -->
    <origin xyz="0 0 0.085" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual><geometry><box size="0.045 0.035 0.02"/></geometry><material name="sensor_green"/></visual>
    <collision><geometry><box size="0.045 0.035 0.02"/></geometry></collision>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="-0.08 0 0.36" rpy="0 0 0"/>
  </joint>
</robot>
