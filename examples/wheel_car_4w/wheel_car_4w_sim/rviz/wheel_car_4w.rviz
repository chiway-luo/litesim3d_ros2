# 单 launch 同时显示四轮车、三维雷达、场景、TF 和轨迹。
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 34; 42
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/RobotModel
      Name: Four Wheel Car
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      TF Prefix: ""
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D Lidar
      Enabled: true
      Topic:
        Value: /points_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
    # 辅助边界与实际回波分色；最大量程受配置控制，不能当作真实障碍。
    - Class: rviz_default_plugins/PointCloud2
      Name: Max Range Boundary (Synthetic)
      Enabled: true
      Topic:
        Value: /points_raw/range_boundary
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 70; 180; 255
      Alpha: 0.3
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: World Objects
      Enabled: true
      Topic:
        Value: /scene
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /trajectory
  # 必须显式列出工具；RViz 加载配置时会清空原有工具。
  # 第一项作为默认工具：左键拖动旋转，Shift+左键拖动平移，滚轮缩放。
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Pitch: 0.65
      Yaw: 0.8
      Focal Point: {X: 1.0, Y: 0, Z: 0.3}
Window Geometry:
  Width: 1200
  Height: 800
