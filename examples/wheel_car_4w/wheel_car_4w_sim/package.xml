<?xml version="1.0"?>
<package format="3">
  <name>wheel_car_4w_sim</name>
  <version>0.1.0</version>
  <description>One-launch four-wheel car simulation with annotated parameters and ROS 2 smoke tests.</description>
  <maintainer email="maintainer@example.com">litesim3d contributors</maintainer>
  <license>Apache-2.0</license>
