<?xml version="1.0"?>
<robot name="omni4" version="1.0" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find omni4_sim)/urdf/mechanical.urdf.xacro"/>
  <xacro:include filename="$(find omni4_sim)/urdf/sensors.xacro"/>
  <litesim3d version="1">
    <chassis name="drive" class="litesim3d_omni4_drive/Omni4Drive">
      <parameters file="package://litesim3d_omni4_drive/config/parameters.yaml"/>
      <parameters file="package://omni4_sim/config/geometry.yaml"/>
    </chassis>
    <odometry name="wheel_odometry" class="litesim3d_omni_odometry/OmniOdometry">
      <parameters file="package://litesim3d_omni_odometry/config/parameters.yaml"/>
      <parameters file="package://omni4_sim/config/geometry.yaml"/>
    </odometry>
  </litesim3d>
</robot>
