set(LITESIM3D_VERSION_FILE "${CMAKE_CURRENT_LIST_DIR}/../VERSION")
file(READ "${LITESIM3D_VERSION_FILE}" LITESIM3D_VERSION)
string(STRIP "${LITESIM3D_VERSION}" LITESIM3D_VERSION)
if(NOT LITESIM3D_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(FATAL_ERROR "VERSION must contain a major.minor.patch version")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${LITESIM3D_VERSION_FILE}")
