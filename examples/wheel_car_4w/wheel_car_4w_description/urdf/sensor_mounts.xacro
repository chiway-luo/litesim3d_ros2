<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="camera_link">
    <visual>
      <origin xyz="-0.025 0 0"/>
      <geometry><box size="0.05 0.09 0.035"/></geometry>
      <material name="camera_black"><color rgba="0.08 0.10 0.13 1"/></material>
    </visual>
    <collision><origin xyz="-0.025 0 0"/><geometry><box size="0.05 0.09 0.035"/></geometry></collision>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/><origin xyz="0.40 0 0.375"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>
</robot>
