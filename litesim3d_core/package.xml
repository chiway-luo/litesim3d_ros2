<?xml version="1.0"?>
<package format="3">
  <name>litesim3d_core</name><version>0.4.0</version>
  <description>Deterministic CPU 3D kinematic simulator core.</description>
  <maintainer email="chiwayfpv@gmail.com">litesim3d contributors</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>litesim3d_plugin_api</depend>
  <depend>eigen</depend><depend>urdfdom</depend><depend>assimp</depend><depend>libfcl-dev</depend>
  <depend>yaml-cpp</depend><depend>tinyxml2</depend><depend>libssl-dev</depend><depend>nlohmann-json-dev</depend>
  <buildtool_depend>pkg-config</buildtool_depend>
  <buildtool_export_depend>pkg-config</buildtool_export_depend>
  <test_depend>gtest</test_depend>
  <url type="repository">https://github.com/chiway-luo/litesim3d_ros2</url>
  <url type="bugtracker">https://github.com/chiway-luo/litesim3d_ros2/issues</url>
  <export><build_type>ament_cmake</build_type></export>
