<robot name="r03">
<link name="base_link"/>
<link name="arm"><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
<link name="slider"><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
<link name="follower"><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
<link name="chain"><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
<link name="tip"><visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></visual><collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.1 0.1 0.1"/></geometry></collision></link>
<joint name="main" type="revolute"><parent link="base_link"/><child link="arm"/><origin xyz="0.2 0 0.5"/><axis xyz="1 1 1"/><limit lower="-1" upper="1" effort="1" velocity="2"/></joint>
<joint name="slide" type="prismatic"><parent link="arm"/><child link="slider"/><origin xyz="0 0 0"/><axis xyz="1 0 0"/><limit lower="0" upper="1" effort="1" velocity="0.5"/></joint>
<joint name="mimic" type="continuous"><parent link="base_link"/><child link="follower"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/><mimic joint="main" multiplier="2" offset="0.1"/></joint>
<joint name="mimic_chain" type="continuous"><parent link="follower"/><child link="chain"/><origin xyz="0 0 0"/><axis xyz="0 1 0"/><mimic joint="mimic" multiplier="0.5" offset="0.2"/></joint>
<joint name="fixed" type="fixed"><parent link="slider"/><child link="tip"/><origin xyz="0 0 0.2"/><axis xyz="0 1 0"/></joint>
</robot>
